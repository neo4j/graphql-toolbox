{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "printWidth": 120,
    "trailingComma": "es5",
    "sortPackageJson": false,
    "overrides": [
        {
            "files": ["*.yaml", "*.yml"],
            "options": {
                "tabWidth": 2
            }
        }
    ],
    "ignorePatterns": ["CHANGELOG.md", ".claude/", "*.md"]
}
