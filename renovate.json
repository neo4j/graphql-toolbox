{
    "extends": ["config:best-practices"],
    "baseBranchPatterns": ["dev"],
    "rebaseWhen": "auto",
    "automerge": true,
    "major": {
        "automerge": false
    },
    "minimumReleaseAge": "3 days",
    "timezone": "Europe/London",
    "schedule": ["* 0-4 1,15 * *"],
    "ignorePaths": [
        "**/node_modules/**",
        "**/bower_components/**",
        "**/vendor/**",
        "**/__tests__/**",
        "**/test/**",
        "**/tests/**",
        "**/__fixtures__/**"
    ],
    "ignoreDeps": ["neo4j", "@graphiql/plugin-doc-explorer", "@graphiql/react"],
    "packageRules": [
        {
            "matchPackageNames": ["@neo4j/graphql-toolbox"],
            "extends": [":pinAllExceptPeerDependencies"]
        },
        {
            "extends": [":pinOnlyDevDependencies"],
            "matchPackageNames": ["!@neo4j/graphql-toolbox"]
        },
        {
            "groupName": "neo4j-ndl",
            "matchPackageNames": ["/^@neo4j-ndl//"]
        }
    ]
}
